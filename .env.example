# Copy to .env (development) or .env.production (server). NEVER commit the real file.
# Values marked REQUIRED must be set by a human; nothing here is a usable secret.

# ---- database (production: owner runs migrations, app role has DML only)
POSTGRES_USER=notice_owner
POSTGRES_PASSWORD=            # REQUIRED (production)
POSTGRES_DB=notice
APP_DB_USER=notice_app
APP_DB_PASSWORD=              # REQUIRED (production)

# ---- site (production)
SITE_ADDRESS=notices.example.com   # hostname served by Caddy; CORS and cookies derive from it
TLS_MODE=internal                  # "internal" (private CA) or an ACME contact email for a public certificate

# ---- email (Hostinger values are defaults; verify against your plan)
EMAIL_MODE=dry_run                 # dry_run = never contacts SMTP. Switch to "smtp" only after approval.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=it@gohimalaya.travel
SMTP_PASSWORD=                     # REQUIRED for EMAIL_MODE=smtp. Enter on the server only.
SMTP_FROM_EMAIL=it@gohimalaya.travel
EMAIL_RATE_PER_MINUTE=20           # set from the verified Hostinger plan limits
EMAIL_RATE_PER_DAY=300
ATTACHMENT_MODE=attach             # attach | link (link = login-protected app URLs)

# ---- first administrator (used only by `python -m app.cli create-admin`, then remove)
BOOTSTRAP_ADMIN_PASSWORD=

# ---- local non-Docker development (backend/.env may also hold these)
# DATABASE_URL=sqlite:///./dev.db
# ENV=development
